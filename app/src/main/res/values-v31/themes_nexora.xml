<?xml version="1.0" encoding="utf-8"?>
<!-- NEXORA splash screen (Android 12+ system splash): AMOLED black with the NEXORA icon. -->
<resources>
    <style name="AppThemeUnifiedDarkNoAnimation" parent="@style/AppTheme.Dark">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:statusBarColor">#05060A</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/AppWindowAnimationNoAnimation</item>
        <item name="android:windowSplashScreenBackground">#05060A</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/nexora_icon_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0E1119</item>
    </style>
</resources>
